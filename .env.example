# انسخ هذا الملف إلى .env.local وعدّل القيم حسب بيئتك

# مفتاح توقيع جلسات الدخول (JWT) — غيّره إلزاميًا في أي بيئة إنتاج، ولا تستخدم القيمة الافتراضية أبدًا خارج التطوير المحلي
JWT_SECRET=dev-secret-change-me-in-production

# مسار ملف قاعدة بيانات SQLite
DATABASE_PATH=./data/app.db

